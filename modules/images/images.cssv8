.images-grid {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  gap: 9px;
  padding: 8px 8px 0;
}

.gallery-hero {
  width: 100%;
  min-width: 0;
}

.gallery-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: start;
  gap: 9px;
  width: 100%;
  min-width: 0;
}

.gallery-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.img-tile {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  overflow: hidden;
  border-radius: 10px;
  background: #f2f2f2;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
}

.img-tile__spacer {
  position: relative;
  width: 100%;
  height: 0;
  overflow: hidden;
  border-radius: 10px;
  background: #f2f2f2;
}

.img-tile__spacer img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 10px;
  object-fit: contain;
  object-position: center;
  background: #f2f2f2;
  opacity: 0;
  transition: opacity 120ms ease-out;
  -webkit-user-drag: none;
}

.img-tile__spacer img.img-loaded {
  opacity: 1;
}

.gallery-hero .img-tile {
  border-radius: 12px;
}

.gallery-hero .img-tile__spacer {
  border-radius: 12px;
}

.gallery-hero .img-tile__spacer img {
  border-radius: 12px;
}

.img-tile__overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 6px;
  padding: 8px;
  background: transparent;
  border-radius: 0 0 10px 10px;
  pointer-events: none;
}

.img-tile__title {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

.gallery-hero .img-tile__title {
  font-size: 13px;
  font-weight: 650;
}

.img-tile__menu {
  flex: 0 0 29px;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 29px;
  height: 29px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.34);
  color: #fff;
  cursor: pointer;
  pointer-events: auto;
  -webkit-tap-highlight-color: transparent;
}

.img-tile__menu:active {
  background: rgba(0, 0, 0, 0.52);
}

.tab-skeleton.grid {
  display: flex;
  align-items: flex-start;
  width: 100%;
  box-sizing: border-box;
  gap: 9px;
  padding: 8px 8px 0;
}

.sk-col {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.sk-img {
  width: 100%;
  height: 0;
  box-sizing: border-box;
  border-radius: 10px;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: sk-shimmer 1.6s ease-in-out infinite;
}

@keyframes sk-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@media (min-width: 600px) {
  .images-grid {
    gap: 10px;
    padding-left: 10px;
    padding-right: 10px;
  }

  .gallery-grid,
  .gallery-col {
    gap: 10px;
  }

  .img-tile,
  .img-tile__spacer,
  .img-tile__spacer img {
    border-radius: 11px;
  }

  .gallery-hero .img-tile,
  .gallery-hero .img-tile__spacer,
  .gallery-hero .img-tile__spacer img {
    border-radius: 13px;
  }
}

@media (prefers-color-scheme: dark) {
  .img-tile,
  .img-tile__spacer,
  .img-tile__spacer img {
    background: #2c2c2e;
  }

  .img-tile__menu {
    background: rgba(255, 255, 255, 0.18);
  }

  .img-tile__menu:active {
    background: rgba(255, 255, 255, 0.30);
  }

  .sk-img {
    background: linear-gradient(90deg, #303032 25%, #3a3a3c 50%, #303032 75%);
    background-size: 200% 100%;
    animation: sk-shimmer 1.6s ease-in-out infinite;
  }
}

@media (prefers-reduced-motion: reduce) {
  .img-tile__spacer img {
    transition: none;
  }

  .sk-img {
    animation: none;
    background: #f0f0f0;
  }

  @media (prefers-color-scheme: dark) {
    .sk-img {
      background: #303032;
    }
  }
}

.sugg-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
  padding: 0 8px;
}

.sugg-row--single {
  grid-template-columns: minmax(0, 1fr);
}

.sugg-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 52px;
  padding: 10px 14px;
  border: 0;
  border-radius: 10px;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
  word-break: break-word;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: background 80ms ease-out;
}

.sugg-pill:active {
  background: #e5e5ea;
}

@media (min-width: 600px) {
  .sugg-row {
    gap: 10px;
    padding: 0 10px;
  }
}

@media (prefers-color-scheme: dark) {
  .sugg-pill {
    background: #2c2c2e;
    color: #f2f2f7;
  }

  .sugg-pill:active {
    background: #3a3a3c;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sugg-pill {
    transition: none;
  }
}
