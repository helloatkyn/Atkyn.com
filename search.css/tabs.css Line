/* tabs.css — Tab bar */

/* ── Tab bar ─────────────────────────────────────────────────── */
.tab-bar {
  position: sticky;
  top: 0;
  z-index: 20;

  display: flex;
  flex-shrink: 0;
  align-items: center;
  height: 40px;
  padding: 0 12px;
  margin-bottom: 3px;

  overflow-x: auto;
  overflow-y: hidden;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;

  background: var(--color-bg);
  border-bottom: 1px solid rgba(35, 35, 35, 0.10);

  /* Transform is applied only while hiding, so text stays pixel-sharp at rest */
  transition:
    transform 0.36s cubic-bezier(0.22, 1, 0.36, 1),
    background-color 0.3s ease,
    border-color 0.3s ease;
}

.tab-bar::-webkit-scrollbar {
  display: none;
}

/* Trailing space so the last tab never touches the edge */
.tab-bar::after {
  content: '';
  flex-shrink: 0;
  width: 12px;
}

.tab-bar.hide {
  transform: translate3d(0, -100%, 0);
  will-change: transform;
}

/* ── Tab ─────────────────────────────────────────────────────── */
.tab {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  height: 100%;
  padding: 0 14px;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.01em;
  white-space: nowrap;

  /* Crisp, high-resolution text rendering */
  text-rendering: optimizeLegibility;
  font-kerning: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;

  color: var(--color-text-muted);
  background: transparent;
  border: 0;

  cursor: pointer;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;

  transition: color 0.16s ease, opacity 0.16s ease;
}

.tab:hover {
  color: var(--color-text-strong);
}

.tab.active {
  font-weight: 600;
  color: var(--color-text-strong);
}

.tab:active {
  opacity: 0.65;
}

.tab:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: -2px;
  border-radius: 6px;
}

/* ── Dark mode ───────────────────────────────────────────────── */
@media (prefers-color-scheme: dark) {
  .tab-bar {
    background: var(--color-bg-dark);
    border-bottom-color: rgba(255, 255, 255, 0.09);
  }

  .tab {
    color: rgba(255, 255, 255, 0.52);
  }

  .tab:hover {
    color: rgba(255, 255, 255, 0.92);
  }

  .tab.active {
    color: rgba(255, 255, 255, 0.96);
  }
}

/* ── Reduced motion ──────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .tab-bar,
  .tab {
    transition: none;
  }
  }
